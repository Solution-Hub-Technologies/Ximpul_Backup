RewriteEngine On

# Handle API requests
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^api/(.*)$ api/$1 [L]

# Handle React Router - exclude PHP files and payment endpoints
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !\.(php|json)$
RewriteCond %{REQUEST_URI} !^/payment-success
RewriteCond %{REQUEST_URI} !^/payment-failed
RewriteCond %{REQUEST_URI} !^/payment-cancelled
RewriteRule . /index.html [L]